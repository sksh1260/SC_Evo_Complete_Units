  "cardDescEn": {},
  "cardDescEnByOwner": {
    "scv|수리": "Repairs mechanical units and structures at the cost of resources.",
    "hydralisk|버로우": "Hides underground. While <span style='color:#fff59d'>burrowed</span>, cannot move or attack, and cannot be detected without <span style='color:#ffd94a'>detection</span>.",
    "hydralisk|럴커로 변태": "Ambush unit that attacks ground units. Must be burrowed to attack.",
    "lurker|버로우": "The <span style='color:#fff59d'>Lurker</span> burrows underground. While <span style='color:#fff59d'>burrowed</span>, the Lurker cannot move but can attack. Its position remains hidden without <span style='color:#ffd94a'>detection</span>.",
    "mutalisk|가디언으로 변태": "Ranged ground assault flyer.",
    "mutalisk|디바우러로 변태": "Powerful anti-air unit. Can use <span style='color:#fff59d'>Acid Spores</span>.",
    "queen|패러사이트": "Attaches a <span style='color:#fff59d'>Parasite</span> to the target unit to share its vision. Lasts indefinitely.",
    "queen|브루들링 소환": "Fires a parasitic brood to kill the target ground unit and spawn <span style='color:#fff59d'>2</span> <span style='color:#fff59d'>Broodlings</span>. If the <span style='color:#fff59d'>Queen</span> dies before impact, the brood detonates and fails.<br><span style='color:#fff59d'>Can target biological or non-robotic mechanical units.</span>",
    "queen|인스네어": "Suppresses movement speed and attack speed buffs. Otherwise, reduces movement speed by <span style='color:#a0c4ff'>50%</span> and attack speed by <span style='color:#a0c4ff'>25%</span> for <span style='color:#fff59d'>20 seconds</span>.<br><span style='color:#fff59d'>Cloaked and burrowed units are revealed.</span><br><span style='color:#fff59d'>Turret weapons do not receive the attack speed reduction.</span>",
    "corsair|디스럽션 웹": "Prevents all enemy units and structures in the target area from attacking for <span style='color:#fff59d'>15 seconds</span>.",
    "sc2_ultralisk|광란": "Immune to slows, stuns, mind control, movement impairment, and parasitic effects."
